&audgpio {
 pinctrl-names = "aud_clk_mosi_off",
   "aud_clk_mosi_on",
   "aud_clk_miso_off",
   "aud_clk_miso_on",
   "aud_dat_mosi_off",
   "aud_dat_mosi_on",
   "aud_dat_miso_off",
   "aud_dat_miso_on",
   "aud_dbmdx_off",
   "aud_dbmdx_on",
   "aud_hs_sw_off",
