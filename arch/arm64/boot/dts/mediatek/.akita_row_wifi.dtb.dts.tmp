  pins_cmd0_dat {
   pinmux = <(((136) << 8) | 0)>;
  };
 };

 aud_clk_mosi_on: aud_clk_mosi_on {
  pins_cmd0_dat {
   pinmux = <(((136) << 8) | 1)>;
  };
 };

 aud_clk_miso_off: aud_clk_miso_off {
  pins_cmd0_dat {
   pinmux = <(((140) << 8) | 0)>;
  };
 };

 aud_clk_miso_on: aud_clk_miso_on {
  pins_cmd0_dat {
   pinmux = <(((140) << 8) | 1)>;
  };
 };

 aud_dat_mosi_off: aud_dat_mosi_off {
  pins_cmd1_dat {
   pinmux = <(((138) << 8) | 0)>;
   input-enable;
   slew-rate = <0>;
   bias-disable;
  };
  pins_cmd2_dat {
   pinmux = <(((139) << 8) | 0)>;
   input-enable;
   slew-rate = <0>;
   bias-disable;
  };
 };

