/dts-v1/;
/plugin/;

&reserved_memory {
 #address-cells = <2>;
 #size-cells = <2>;
 ranges;

 zmc-default {
  compatible = "mediatek,zone_movable_cma";
  size = <0 0xffc00000>;
  alignment = <0 0x10000000>;
  alloc-ranges = <0 0xc0000000 1 0x00000000>;
 };
};


&chosen {



 atag,videolfb-fb_base_h = <0x0>;
 atag,videolfb-fb_base_l = <0x5e605000>;
 atag,videolfb-islcmfound = <1>;

 atag,videolfb-islcm_inited = <0>;
 atag,videolfb-fps= <6000>;
 atag,videolfb-vramSize= <0x017bb000>;
 atag,videolfb-lcmname= "nt35521_hd_dsi_vdo_truly_rt5081_drv";
};

&odm {
 led0:led@0 {
  compatible = "mediatek,red";
  led_mode = <2>;
  data = <1>;
  pwm_config = <0 0 0 0 0>;
 };
 led1:led@1 {
  compatible = "mediatek,green";
  led_mode = <2>;
  data = <1>;
  pwm_config = <0 0 0 0 0>;
 };
 led2:led@2 {
  compatible = "mediatek,blue";
  led_mode = <3>;
  data = <2>;
  pwm_config = <0 0 0 0 0>;
 };
 led3:led@3 {
  compatible = "mediatek,jogball-backlight";
  led_mode = <0>;
  data = <1>;
  pwm_config = <0 0 0 0 0>;
 };
 led4:led@4 {
  compatible = "mediatek,keyboard-backlight";
  led_mode = <0>;
  data = <1>;
  pwm_config = <0 0 0 0 0>;
 };
 led5:led@5 {
  compatible = "mediatek,button-backlight";
  led_mode = <0>;
  data = <1>;
  pwm_config = <0 0 0 0 0>;
 };
 led6:led@6 {
  compatible = "mediatek,lcd-backlight";
  led_mode = <5>;
  data = <1>;
  pwm_config = <0 0 0 0 0>;
 };
 vibrator0:vibrator@0 {
  compatible = "mediatek,vibrator";
  vib_timer = <25>;
  vib_limit = <9>;
  vib_vol= <9>;
 };
 memory_ssmr_features: memory-ssmr-features {
  compatible = "mediatek,memory-ssmr-features";
  svp-size = <0 0>;
  iris-recognition-size = <0 0>;
  2d_fr-size = <0 0>;
  tui-size = <0 0>;
  wfd-size = <0 0>;
  prot-sharedmem-size = <0 0>;
 };
};

&led_pinctrl {
 pinctrl-names = "default", "red_on", "red_off", "green_on", "green_off";
 pinctrl-0 = <&led_pins_default>;
 pinctrl-1 = <&led_red_on>;
 pinctrl-2 = <&led_red_off>;
 pinctrl-3 = <&green_red_on>;
 pinctrl-4 = <&green_red_off>;
 status = "okay";
};

&pio {
 led_pins_default: leddefault {
 };
 led_red_on: redon {
  pins_cmd_dat {
   pinmux = <(((4) << 8) | 0)>;
   slew-rate = <1>;
   output-high;
  };
 };
 led_red_off: redoff {
  pins_cmd_dat {
   pinmux = <(((4) << 8) | 0)>;
   slew-rate = <1>;
   output-low;
  };
 };
 green_red_on:greenon {
  pins_cmd_dat {
   pinmux = <(((0) << 8) | 0)>;
   slew-rate = <1>;
   output-high;
  };
 };
 green_red_off: greenoff {
  pins_cmd_dat {
   pinmux = <(((0) << 8) | 0)>;
   slew-rate = <1>;
   output-low;
  };
 };
};


&i2c0 {
    cap_touch@38 {
        compatible = "mediatek,cap_touch" ;
        reg = < 0x38 > ;
        status = "okay" ;
    };
};

&i2c2 {
 #address-cells = <1>;
 #size-cells = <0>;
 clock-frequency = <400000>;

 mtk-usb@60 {
  compatible = "mediatek,mtk-usb";
  reg = <0x60>;
  status = "okay";
 };
};

&i2c3 {
 ext_buck_lp4@57 {
  regulator-name ="ext_buck_vdd2";
  regulator-min-microvolt = <300000>;
  regulator-max-microvolt = <1300000>;
  vsel_pin = <0>;
 };

 ext_buck_lp4x@50 {
  regulator-name ="ext_buck_vddq";
  regulator-min-microvolt = <300000>;
  regulator-max-microvolt = <1300000>;
  vsel_pin = <1>;
 };

 mic_array@38{
  compatible = "ac107_0";
  reg = <0x38>;
  pinctrl-names = "state_power_off","state_power_on";
  pinctrl-0 = <&aud_pins_ac107_off>;
  pinctrl-1 = <&aud_pins_ac107_on>;
 };

    sx9311@28 {
        compatible = "mediatek,SAR";
        reg = <0x28>;
     interrupt-parent = <&pio>;
     interrupts = <11 2 11 0>;
      int-gpio = <&pio 11 0>;
        polling_mode = <0>;
     power_id = <0xffff>;
     Semtech,reg-init = < 0x03 0x70
            0x04 0x00
                                    0x10 0x27
            0x11 0x00
            0x12 0x0b
            0x13 0x0A
            0x14 0x25
            0x15 0xC3
            0x16 0x20
            0x17 0x4C
            0x18 0x28
            0x19 0x38
            0x1A 0x10
            0x1B 0x00
            0x1C 0x00
            0x1D 0x00
            0x1E 0x00
            0x1F 0x00
            0x20 0x00
            0x21 0x18
            0x22 0x25
            0x23 0x00
            0x2A 0x01>;
        status = "okay";
    };
};

&pio {
 aud_pins_ac107_off: aud_pins_ac107_off {
  pins_cmd_dat {
   pinmux = <(((87) << 8) | 0)>;
   slew-rate = <1>;
   output-low;
  };
 };
 aud_pins_ac107_on: aud_pins_ac107_on{
  pins_cmd_dat {
   pinmux = <(((87) << 8) | 0)>;
   slew-rate = <1>;
   output-high;
  };
 };
};

&i2c6 {
 ext_buck_vgpu@55 {
  regulator-name ="ext_buck_vgpu";
  regulator-min-microvolt = <300000>;
  regulator-max-microvolt = <1300000>;
  vsel_pin = <2>;
 };

 aw87519@58 {
  compatible = "awinic,aw87519_left";
  reg = <0x58>;
  reset-gpio = <&pio 174 0>;
  status = "okay";
 };

 aw87519@5b {
  compatible = "awinic,aw87519_right";
  reg = <0x5b>;
  reset-gpio = <&pio 153 0>;
  status = "okay";
 };
};


