# 1 "./arch/arm64/boot/dts/akita_row_wifi/cust.dtsi" 1
# 12 "./arch/arm64/boot/dts/akita_row_wifi/cust.dtsi"
&auxadc {
 adc_channel@ {
  compatible = "mediatek,adc_channel";
  mediatek,temperature0 = <0>;
  mediatek,temperature1 = <1>;
  mediatek,adc_fdd_rf_params_dynamic_custom_ch = <2>;
  status = "okay";
 };
};






&pmic_clock_buffer_ctrl {
 mediatek,clkbuf-quantity = <7>;
 mediatek,clkbuf-config = <2 1 1 2 0 0 0>;
 mediatek,clkbuf-driving-current = <1 1 1 1 1 1 1>;
 status = "okay";
};






&i2c0 {
 #address-cells = <1>;
 #size-cells = <0>;
 clock-frequency = <400000>;
 mediatek,use-push-pull;
 cap_touch_mtk:cap_touch@38 {
  compatible = "mediatek,cap_touch";
  reg = <0x38>;
  status = "okay";
 };

};

&i2c1 {
 #address-cells = <1>;
 #size-cells = <0>;
 clock-frequency = <400000>;
 mediatek,use-open-drain;
};

&i2c2 {
 #address-cells = <1>;
 #size-cells = <0>;
 clock-frequency = <400000>;
 mediatek,use-open-drain;
 camera_main_mtk:camera_main@1a {
