 firmware {
  android {
   compatible = "android,firmware";

   vbmeta {
    compatible = "android,vbmeta";




    parts = "vbmeta,boot,system,vendor,recovery";
# 2843 "arch/arm64/boot/dts/mediatek/mt6761.dts"
   };

   fstab {
    compatible = "android,fstab";
# 2865 "arch/arm64/boot/dts/mediatek/mt6761.dts"
    vendor {
     compatible = "android,vendor";
     dev = "/dev/block/platform/bootdevice/by-name/vendor";
     type = "ext4";
     mnt_flags = "ro";



     fsmgr_flags = "wait,avb";
# 2891 "arch/arm64/boot/dts/mediatek/mt6761.dts"
    };
# 2924 "arch/arm64/boot/dts/mediatek/mt6761.dts"
    product {
     compatible = "android,product";
     dev = "/dev/block/platform/bootdevice/by-name/product";
     type = "ext4";
     mnt_flags = "rw,noatime";
     fsmgr_flags = "wait";
    };
   };
  };
 };

