# 0 "arch/arm64/boot/dts/mediatek/mt6761.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/mediatek/mt6761.dts"
# 16 "arch/arm64/boot/dts/mediatek/mt6761.dts"
/dts-v1/;
# 1 "./arch/arm64/boot/dts/include/dt-bindings/interrupt-controller/arm-gic.h" 1







# 1 "./arch/arm64/boot/dts/include/dt-bindings/interrupt-controller/irq.h" 1
# 9 "./arch/arm64/boot/dts/include/dt-bindings/interrupt-controller/arm-gic.h" 2
# 18 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2

# 1 "./arch/arm64/boot/dts/include/dt-bindings/pinctrl/mt6761-pinfunc.h" 1
# 17 "./arch/arm64/boot/dts/include/dt-bindings/pinctrl/mt6761-pinfunc.h"
# 1 "./arch/arm64/boot/dts/include/dt-bindings/pinctrl/mt65xx.h" 1
# 18 "./arch/arm64/boot/dts/include/dt-bindings/pinctrl/mt6761-pinfunc.h" 2
# 20 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
# 1 "./arch/arm64/boot/dts/include/dt-bindings/memory/mt6761-larb-port.h" 1
# 21 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
# 1 "./arch/arm64/boot/dts/include/dt-bindings/mmc/mt6761-msdc.h" 1
# 22 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
# 1 "./arch/arm64/boot/dts/include/dt-bindings/clock/mt6761-clk.h" 1
# 23 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
# 1 "./arch/arm64/boot/dts/include/dt-bindings/iio/mt635x-auxadc.h" 1
# 24 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
# 1 "./arch/arm64/boot/dts/include/dt-bindings/gce/mt6765-gce.h" 1
# 25 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
# 1 "./include/generated/autoconf.h" 1
# 26 "arch/arm64/boot/dts/mediatek/mt6761.dts" 2
/ {
 model = "MT6761";
 compatible = "mediatek,MT6761";
 interrupt-parent = <&sysirq>;
 #address-cells = <2>;
 #size-cells = <2>;


 chosen: chosen {
 bootargs = "console=tty0 console=ttyS0,921600n1 vmalloc=496M slub_max_order=0 slub_debug=OFZPU page_owner=on androidboot.hardware=mt6761 maxcpus=8 firmware_class.path=/vendor/firmware loop.max_part=7";



  kaslr-seed = <0 0>;
 };

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;

  cpu0: cpu@000 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x000>;
   enable-method = "psci";
   clock-frequency = <2340000000>;
   cpu-idle-states = <&STANDBY &MCDI_CPU &MCDI_CLUSTER>,
       <&SODI &SODI3 &DPIDLE &SUSPEND>;
  };

  cpu1: cpu@001 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x001>;
   enable-method = "psci";
   clock-frequency = <2340000000>;
   cpu-idle-states = <&STANDBY &MCDI_CPU &MCDI_CLUSTER>,
       <&SODI &SODI3 &DPIDLE &SUSPEND>;
  };

  cpu2: cpu@002 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x002>;
   enable-method = "psci";
   clock-frequency = <2340000000>;
   cpu-idle-states = <&STANDBY &MCDI_CPU &MCDI_CLUSTER>,
       <&SODI &SODI3 &DPIDLE &SUSPEND>;
  };

  cpu3: cpu@003 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x003>;
   enable-method = "psci";
   clock-frequency = <2340000000>;
   cpu-idle-states = <&STANDBY &MCDI_CPU &MCDI_CLUSTER>,
       <&SODI &SODI3 &DPIDLE &SUSPEND>;
  };

  cpu-map {
   cluster0 {
    core0 {
     cpu = <&cpu0>;
    };
    core1 {
     cpu = <&cpu1>;
    };
    core2 {
     cpu = <&cpu2>;
    };
    core3 {
     cpu = <&cpu3>;
    };
   };
  };

  idle-states {
   entry-method = "arm,psci";

   STANDBY: standby {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x00000001>;
    entry-latency-us = <600>;
    exit-latency-us = <600>;
    min-residency-us = <1200>;
   };

   MCDI_CPU: mcdi-cpu {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x00010001>;
    entry-latency-us = <600>;
    exit-latency-us = <600>;
    min-residency-us = <1200>;
   };

   MCDI_CLUSTER: mcdi-cluster {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x01010001>;
    entry-latency-us = <600>;
    exit-latency-us = <600>;
    min-residency-us = <1200>;
   };

   SODI: sodi {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x01010002>;
    entry-latency-us = <800>;
    exit-latency-us = <1000>;
    min-residency-us = <2000>;
   };

   SODI3: sodi3 {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x01010003>;
    entry-latency-us = <800>;
    exit-latency-us = <1000>;
    min-residency-us = <2000>;
   };

   DPIDLE: dpidle {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x01010004>;
    entry-latency-us = <800>;
    exit-latency-us = <1000>;
    min-residency-us = <2000>;
   };

   SUSPEND: suspend {
    compatible = "arm,idle-state";
    arm,psci-suspend-param = <0x01010005>;
    entry-latency-us = <800>;
    exit-latency-us = <1000>;
    min-residency-us = <2000>;
   };
  };
 };

 psci {
  compatible = "arm,psci-1.0";
  method = "smc";
 };

 pmu {
  compatible = "arm,armv8-pmuv3";
  interrupt-parent = <&gic>;
  interrupts = <1 7 8>;
 };

 l2c_parity {
  compatible = "mediatek,l2c_parity-v1";
  interrupts = <0 0 4>;
 };

 memory {
  device_type = "memory";
  reg = <0 0x40000000 0 0x20000000>;
 };

 reserved_memory: reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  ram_console-reserved-memory@47c80000 {
   compatible = "mediatek,ram_console";
   reg = <0 0x47c80000 0 0x10000>;
  };

  pstore-reserved-memory@47c90000 {
   compatible = "mediatek,pstore";
   reg = <0 0x47c90000 0 0xe0000>;
  };

  minirdump-reserved-memory@47d70000{
   compatible = "mediatek,minirdump";
   reg = <0 0x47d70000 0 0x10000>;
  };

  reserve-memory-sspm_share {
   compatible = "mediatek,reserve-memory-sspm_share";
   no-map;
   status = "okay";



   size = <0 0x510000>;

   alignment = <0 0x10000>;
   alloc-ranges = <0 0x40000000 0 0x60000000>;
  };

  reserve-memory-scp_share {
   compatible = "mediatek,reserve-memory-scp_share";
   no-map;
   size = <0 0x00300000>;
   alignment = <0 0x1000000>;
   alloc-ranges = <0 0x40000000 0 0x50000000>;
  };

  consys-reserve-memory {
   compatible = "mediatek,consys-reserve-memory";
   no-map;
   size = <0 0x400000>;
   alignment = <0 0x1000000>;
   alloc-ranges = <0 0x40000000 0 0x80000000>;
  };

  wifi-reserve-memory {
   compatible = "mediatek,wifi-reserve-memory";
   no-map;
   size = <0 0x300000>;
   alignment = <0 0x1000000>;
   alloc-ranges = <0 0x40000000 0 0x80000000>;
  };


  soter-shared-mem {
   compatible = "microtrust,shared_mem";
   no-map;
   size = <0 0x200000>;
   alloc-ranges = <0 0x40000000 0 0x50000000>;
  };


 };


 utos {
  compatible = "microtrust,utos";
  interrupts = <0 188 1>,
   <0 189 1>;
 };
 utos_tester {
  compatible = "microtrust,tester-v1";
 };

 cpu_dbgapb: cpu_dbgapb@0d410000 {
  compatible = "mediatek,hw_dbg";
  num = <8>;
  reg = <0 0x0d410000 0 0x1000>,
   <0 0x0d510000 0 0x1000>,
   <0 0x0d610000 0 0x1000>,
   <0 0x0d710000 0 0x1000>,
   <0 0x0d810000 0 0x1000>,
   <0 0x0d910000 0 0x1000>,
   <0 0x0da10000 0 0x1000>,
   <0 0x0db10000 0 0x1000>;
 };


 atf_logger {
  compatible = "mediatek,atf_logger";
  interrupts = <0 78 1>;
 };


 amms_control {
  compatible = "mediatek,amms";
  interrupts = <0 67 1>;
 };

 gic: interrupt-controller@0c000000 {
  compatible = "arm,gic-v3";
  #interrupt-cells = <3>;
  #address-cells = <2>;
  #size-cells = <2>;
  #redistributor-regions = <1>;
  interrupt-parent = <&gic>;
  interrupt-controller;
  reg = <0 0x0c000000 0 0x40000>,
        <0 0x0c080000 0 0x200000>,
        <0 0x10200a80 0 0x50>;
  interrupts = <1 9 4>;
 };

 sysirq: intpol-controller@10200a80 {
  compatible = "mediatek,mt6577-sysirq";
  interrupt-controller;
  #interrupt-cells = <3>;
  interrupt-parent = <&gic>;
  reg = <0 0x10200a80 0 0x50>;
 };

 infracfg_ao: infracfg_ao@10001000 {
  compatible = "mediatek,infracfg_ao", "syscon";
  reg = <0 0x10001000 0 0x1000>;
  interrupts = <0 91 1>;
  #clock-cells = <1>;
 };

 mcdi@0010fc00 {
  compatible = "mediatek,mt6761-mcdi";
  reg = <0 0x0010fc00 0 0x800>;
 };

 scpsys: scpsys@10001000 {
  compatible = "mediatek,scpsys", "syscon";
  reg = <0 0x10001000 0 0x1000>,
    <0 0x10006000 0 0x1000>,
    <0 0x14002000 0 0x1000>,
    <0 0x1020e000 0 0x1000>,
    <0 0x18004000 0 0x1000>;
  #clock-cells = <1>;
 };


 topckgen: topckgen@10000000 {
  compatible = "mediatek,topckgen", "syscon";
  reg = <0 0x10000000 0 0x1000>;
  #clock-cells = <1>;
 };

 io_cfg_lt@10002000 {
  compatible = "mediatek,io_cfg_lt";
  reg = <0 0x10002000 0 0x200>;
 };

 syscfg_pctl_1: syscfg_pctl_1@10002000 {
  compatible = "mediatek,mt6761-pctl-1-syscfg", "syscon";
  reg = <0 0x10002000 0 0x1000>;
 };

 io_cfg_lm@10002200 {
  compatible = "mediatek,io_cfg_lm";
  reg = <0 0x10002200 0 0x200>;
 };

 syscfg_pctl_2: syscfg_pctl_2@10002200 {
  compatible = "mediatek,mt6761-pctl-2-syscfg", "syscon";
  reg = <0 0x10002200 0 0x1000>;
 };

 io_cfg_lb@10002400 {
  compatible = "mediatek,io_cfg_lb";
  reg = <0 0x10002400 0 0x200>;
 };

 syscfg_pctl_3: syscfg_pctl_3@10002400 {
  compatible = "mediatek,mt6761-pctl-3-syscfg", "syscon";
  reg = <0 0x10002400 0 0x1000>;
 };

 io_cfg_bl@10002600 {
  compatible = "mediatek,io_cfg_bl";
  reg = <0 0x10002600 0 0x200>;
 };

 syscfg_pctl_4: syscfg_pctl_4@10002600 {
  compatible = "mediatek,mt6761-pctl-4-syscfg", "syscon";
  reg = <0 0x10002600 0 0x1000>;
 };

 io_cfg_rr@10002800 {
  compatible = "mediatek,io_cfg_rr";
  reg = <0 0x10002800 0 0x200>;
 };

 syscfg_pctl_5: syscfg_pctl_5@10002800 {
  compatible = "mediatek,mt6761-pctl-5-syscfg", "syscon";
  reg = <0 0x10002800 0 0x1000>;
 };

 io_cfg_rb@10002a00 {
  compatible = "mediatek,io_cfg_rb";
  reg = <0 0x10002a00 0 0x200>;
 };

 syscfg_pctl_6: syscfg_pctl_6@10002a00 {
  compatible = "mediatek,mt6761-pctl-6-syscfg", "syscon";
  reg = <0 0x10002a00 0 0x1000>;
 };

 io_cfg_rt@10002c00 {
  compatible = "mediatek,io_cfg_rt";
  reg = <0 0x10002c00 0 0x200>;
 };

 syscfg_pctl_7: syscfg_pctl_7@10002c00 {
  compatible = "mediatek,mt6761-pctl-7-syscfg", "syscon";
  reg = <0 0x10002c00 0 0x1000>;
 };

 pericfg: pericfg@10003000 {
  compatible = "mediatek,pericfg", "syscon";
  reg = <0 0x10003000 0 0x1000>;
  #clock-cells = <1>;
 };

 efuse_dbg@10004000 {
  compatible = "mediatek,efuse_dbg";
  reg = <0 0x10004000 0 0x1000>;
 };

 smart_pa: smart_pa {

 };

 tcpc_pd: tcpc_pd {

 };

 md1_sim1_hot_plug_eint: md1_sim1_hot_plug_eint {

 };

 md1_sim2_hot_plug_eint: md1_sim2_hot_plug_eint {

 };

 gpio_usage_mapping:gpio {
  compatible = "mediatek,gpio_usage_mapping";
 };

 gpio: gpio@10005000 {
  compatible = "mediatek,gpio";
  reg = <0 0x10005000 0 0x1000>;
 };

 syscfg_pctl_0: syscfg_pctl_0@10005000 {
  compatible = "mediatek,mt6761-pctl-0-syscfg", "syscon";
  reg = <0 0x10005000 0 0x1000>;
 };

 sleep@10006000 {
  compatible = "mediatek,sleep";
  reg = <0 0x10006000 0 0x1000>;
  interrupts = <0 125 8>;
  wakeup-source = <&keypad 0 (1 << 2)>,
    <&consys 1 (1 << 5)>,
    <&mdcldma 3 (1 << 25)>;
 };

 pio: pinctrl@1000b000 {
  compatible = "mediatek,mt6761-pinctrl";
  reg = <0 0x1000b000 0 0x1000>;
  mediatek,pctl-regmap = <&syscfg_pctl_0>,
         <&syscfg_pctl_1>,
         <&syscfg_pctl_2>,
         <&syscfg_pctl_3>,
         <&syscfg_pctl_4>,
         <&syscfg_pctl_5>,
         <&syscfg_pctl_6>,
         <&syscfg_pctl_7>;
  pins-are-numbered;
  gpio-controller;
  #gpio-cells = <2>;
  interrupt-controller;
  #interrupt-cells = <4>;
  interrupts = <0 115 4>;
 };

 toprgu@10007000 {
  compatible = "mediatek,toprgu";
  reg = <0 0x10007000 0 0x1000>;
  interrupts = <0 83 0>;
 };

 chipid@08000000 {
  compatible = "mediatek,chipid";
  reg = <0 0x08000000 0 0x0004>,
        <0 0x08000004 0 0x0004>,
        <0 0x08000008 0 0x0004>,
        <0 0x0800000c 0 0x0004>;
 };

 mobicore {
  compatible = "trustonic,mobicore";
  interrupts = <0 194 1>;
 };

 tkcore {
     compatible = "trustkernel,tkcore";
     interrupts = <0 196 1>;
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&gic>;
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>;
  clock-frequency = <13000000>;


 };

 clocks {
  clk26m: clk26m {
   compatible = "fixed-clock";
   #clock-cells = <0>;
   clock-frequency = <26000000>;
  };




  clk32k: clk32k {
   compatible = "fixed-clock";
   #clock-cells = <0>;
   clock-frequency = <32000>;
  };
 };

 timer: timer@10008000 {
  compatible = "mediatek,apxgpt";
  reg = <0 0x10008000 0 0x1000>;
  interrupts = <0 114 8>;
  clocks =
   <&topckgen 135>,
   <&clk32k>;
  clock-names =
   "clk13m",
   "clk32k";
 };

 hacc@1000a000 {
  compatible = "mediatek,hacc";
  reg = <0 0x1000a000 0 0x1000>;
  interrupts = <0 133 8>;
 };

 apirq@1000b000 {
  compatible = "mediatek,apirq";
  reg = <0 0x1000b000 0 0x1000>;
  interrupts = <0 115 4>;
 };

 apmixed: apmixed@1000c000 {
  compatible = "mediatek,apmixed", "syscon";
  reg = <0 0x1000c000 0 0x1000>;
  #clock-cells = <1>;
 };

 fhctl@1000ce00 {
  compatible = "mediatek,fhctl";
  reg = <0 0x1000ce00 0 0x200>;
 };

 pwrap@1000d000 {
  compatible = "mediatek,pwrap";
  reg = <0 0x1000d000 0 0x1000>;
  interrupts = <0 123 4>;
 };

 main_pmic: mt-pmic {
  compatible = "mediatek,mt_pmic";
  interrupt-controller;
 };

 scp@10500000 {
  compatible = "mediatek,scp";
  status = "okay";
  reg = <0 0x10500000 0 0x40000>,
    <0 0x105c0000 0 0x3000>,
    <0 0x105c4000 0 0x1000>,
    <0 0x105d4000 0 0x6000>;
  interrupts = <0 136 4>;
  core_1 = "enable";
  scp_sramSize = <0x00040000>;
 };

 scp_dvfs {
  compatible = "mediatek,scp_dvfs";
  clocks = <&topckgen 108>,
   <&clk26m>,
   <&topckgen 16>,
   <&topckgen 29>,
   <&topckgen 4>,
   <&topckgen 26>,
   <&topckgen 8>,
   <&topckgen 28>;

  clock-names = "clk_mux",
   "clk_pll_0",
   "clk_pll_1",
   "clk_pll_2",
   "clk_pll_3",
   "clk_pll_4",
   "clk_pll_5",
   "clk_pll_6";
 };

 sleep_reg_md@1000f000 {
  compatible = "mediatek,sleep_reg_md";
  reg = <0 0x1000f000 0 0x1000>;
 };

 keypad: kp@10010000 {
  compatible = "mediatek,kp";
  reg = <0 0x10010000 0 0x1000>;
  interrupts = <0 124 2>;
 };

 mrdump_ext_rst: mrdump_ext_rst {
  compatible = "mediatek, mrdump_ext_rst-eint";
  source = "EINT";
  mode = "IRQ";
  status = "okay";
 };

 lcm: lcm_gpio {
  compatible = "mediatek,lcm_gpio";
 };

 touch: touch {
  compatible = "mediatek,touch";
 };

 accdet: accdet {
  compatible = "mediatek,pmic-accdet";
 };

 dbmdx: dbmdx {
  compatible = "dspg,dbmdx-codec";
 };

 dbmdx_soundcard: dbmdx-soundcard {
  compatible = "dbmdx,dbmdx-soundcard";
 };

 goodix_fp: fingerprint {
  compatible = "mediatek,goodix-fp";
 };

 mt6357_gauge {
  compatible = "mediatek,mt6357_gauge";
  gauge_name = "gauge";
  alias_name = "mt6357";
 };

 gauge_timer {
  compatible = "mediatek,gauge_timer_service";
 };


# 1 "arch/arm64/boot/dts/mediatek/bat_setting/mt6761_battery_prop_ext.dtsi" 1
# 14 "arch/arm64/boot/dts/mediatek/bat_setting/mt6761_battery_prop_ext.dtsi"
bat_gm30: battery{
 compatible = "mediatek,bat_gm30";

 DIFFERENCE_FULLOCV_ITH = <(200)>;

 SHUTDOWN_1_TIME = <(5)>;

 KEEP_100_PERCENT = <(1)>;
 R_FG_VALUE = <(10)>;

 EMBEDDED_SEL = <(0)>;
 PMIC_SHUTDOWN_CURRENT = <(20)>;
 FG_METER_RESISTANCE = <(75)>;

 CAR_TUNE_VALUE = <(100)>;
 PMIC_MIN_VOL = <(33500)>;

 POWERON_SYSTEM_IBOOT = <(500)>;

 SHUTDOWN_GAUGE0_VOLTAGE = <(34000)>;

 TEMPERATURE_T0 = <(50)>;
 TEMPERATURE_T1 = <(25)>;
 TEMPERATURE_T2 = <(10)>;
