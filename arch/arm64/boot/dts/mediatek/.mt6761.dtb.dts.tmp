  iommus = <&iommu (((1) << 5) | (0))>,
    <&iommu (((1) << 5) | (1))>;
 };

 pseudo_m4u-larb2 {
  compatible = "mediatek,mt-pseudo_m4u-port";
  mediatek,larbid = <2>;
  iommus = <&iommu (((2) << 5) | (0))>,
    <&iommu (((2) << 5) | (1))>;
 };

 radio_md_cfg: radio_md_cfg {
  compatible = "mediatek,radio_md_cfg";
 };

 dynamic_options: dynamic_options {
  compatible = "mediatek,dynamic_options";
 };

 led_pinctrl: led_pinctrl{
